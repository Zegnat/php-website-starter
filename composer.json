{
    "name": "zegnat/website-starter",
    "description": "My minimum viable setup for starting a PHP project.",
    "type": "project",
    "version": "6.0.0",
    "license": "0BSD",
    "authors": [
        {
            "name": "Martijn van der Ven",
            "email": "martijn@vanderven.se"
        }
    ],
    "autoload": {
        "psr-4": {"app\\": "app/"}
    },
    "require": {
        "php": "^8.2",
        "laminas/laminas-diactoros": "^3.0",
        "laminas/laminas-httphandlerrunner": "^2.0",
        "middlewares/fast-route": "^2.1",
        "oscarotero/middleland": "^1.0.3",
        "php-di/php-di": "^7.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "ext-pcov": "Enables code coverage for the coverage script (ext-xdebug also works)"
    },
    "scripts": {
        "check-style": "php-cs-fixer fix --dry-run -vvv",
        "fix-style": "php-cs-fixer fix",
        "test": "phpunit",
        "coverage": "phpunit --coverage-text",
        "serve": "@php -S localhost:8000 -t public/"
    },
    "config": {
        "sort-packages": true
    }
}
